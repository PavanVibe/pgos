generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

enum SubscriptionTier {
  STARTER
  GROWTH
  SCALE
}

enum TenantStatus {
  ACTIVE
  NOTICE
  PAST
  INCOMPLETE
}

enum InvoiceStatus {
  PENDING
  PAST_DUE
  PAID
  PARTIALLY_PAID
}

enum ComplaintPriority {
  LOW
  HIGH
  URGENT
}

enum ComplaintStatus {
  PENDING
  ESCALATED
  RESOLVED
}

enum StaffRole {
  MANAGER
  CLEANER
  MAINTENANCE
}

model Organization {
  id               String           @id @default(uuid())
  name             String
  clerkOrgId       String           @unique
  subscriptionTier SubscriptionTier @default(STARTER)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  
  isActive         Boolean          @default(true)
  deletedAt        DateTime?

  pgs              PG[]
  staff            Staff[]
}

model PG {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  city           String
  address        String?
  
  createdBy      String?
  updatedBy      String?
  isActive       Boolean           @default(true)
  deletedAt      DateTime?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  
  organization   Organization      @relation(fields: [organizationId], references: [id])
  rooms          Room[]
  expenses       Expense[]
  complaints     Complaint[]
  tenantProfiles PGTenantProfile[]
  damageRecoveries DamageRecovery[]
  staff          Staff[]
  cleaningChecklist CleaningChecklist?
  monthlyBusinessSnapshots MonthlyBusinessSnapshot[]

  @@index([organizationId])
  @@index([isActive])
}

model Room {
  id        String   @id @default(uuid())
  pgId      String
  floor     String?
  number    String
  capacity  Int
  
  createdBy String?
  updatedBy String?
  isActive  Boolean  @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  pg             PG                @relation(fields: [pgId], references: [id])
  beds           Bed[]
  tenantProfiles PGTenantProfile[]
  damageRecoveries DamageRecovery[]

  @@index([pgId])
  @@index([isActive])
}

model Bed {
  id            String           @id @default(uuid())
  roomId        String
  bedNumber     String
  monthlyRent   Float
  
  createdBy     String?
  updatedBy     String?
  isActive      Boolean          @default(true)
  deletedAt     DateTime?

  tenantProfile PGTenantProfile?
  room          Room             @relation(fields: [roomId], references: [id])

  @@index([roomId])
  @@index([isActive])
}

model GlobalTenant {
  id                   String            @id @default(uuid())
  phone                String            @unique
  name                 String?
  email                String?           @unique
  maskedAadhaar        String?
  encryptedAadhaarHash String?
  kycDocUrl            String?
  trustScore           Int               @default(100)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  
  isActive             Boolean           @default(true)
  deletedAt            DateTime?

  profiles             PGTenantProfile[]
}

model PGTenantProfile {
  id              String         @id @default(uuid())
  globalTenantId  String
  pgId            String
  bedId                String?        @unique
  roomId               String
  historicalRoomNumber String?
  historicalBedNumber  String?
  status               TenantStatus   @default(ACTIVE)
  monthlyRent          Float          @default(0)
  securityDeposit      Float          @default(0)
  securityDepositStatus String         @default("PENDING")
  depositCollectedAt    DateTime?
  depositRefundedAmount Float?
  depositDeductionAmount Float?         @default(0)
  depositRefundedAt     DateTime?
  depositRefundMode     String?
  depositRefundNotes    String?
  settlementStatus      String         @default("OPEN")
  moveInDate           DateTime       @default(now())
  moveOutDate          DateTime?
  
  createdBy            String?
  updatedBy            String?
  isActive             Boolean        @default(true)
  deletedAt            DateTime?

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  
  globalTenant         GlobalTenant   @relation(fields: [globalTenantId], references: [id])
  pg                   PG             @relation(fields: [pgId], references: [id])
  bed                  Bed?           @relation(fields: [bedId], references: [id])
  room                 Room           @relation(fields: [roomId], references: [id])
  invoices             RentInvoice[]
  complaints           Complaint[]
  damageRecoveries     DamageRecovery[]
  depositTransactions  DepositLedgerTransaction[]
  paymentReceipts      PaymentReceipt[]

  @@index([globalTenantId])
  @@index([pgId])
  @@index([roomId])
  @@index([isActive])
  @@index([bedId, status])
}

model RentInvoice {
  id            String          @id @default(uuid())
  pgTenantId    String
  amount        Float
  paidAmount    Float           @default(0)
  dueDate       DateTime
  status        InvoiceStatus   @default(PENDING)
  razorpayOrdId String?
  razorpayPayId String?
  paidAt        DateTime?
  paymentMode   String?
  referenceId   String?
  type          String          @default("RENT")
  
  createdBy     String?
  updatedBy     String?
  isActive      Boolean         @default(true)
  deletedAt     DateTime?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenantProfile PGTenantProfile @relation(fields: [pgTenantId], references: [id])
  paymentLinks  PaymentLink[]
  paymentReceipts PaymentReceipt[]

  @@index([pgTenantId])
  @@index([dueDate])
}

model Expense {
  id         String   @id @default(uuid())
  pgId       String
  category   String
  amount     Float
  incurredAt DateTime @default(now())
  receiptUrl String?
  title      String   @default("Expense")
  notes      String?
  
  createdBy  String?
  updatedBy  String?
  isActive   Boolean  @default(true)
  deletedAt  DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  pg         PG       @relation(fields: [pgId], references: [id])

  @@index([pgId])
}

model Complaint {
  id                 String            @id @default(uuid())
  pgId               String
  pgTenantId         String
  category           String
  description        String
  imageUrl           String?
  priority           ComplaintPriority @default(LOW)
  status             ComplaintStatus   @default(PENDING)
  slaDeadline        DateTime
  assignedResolverId String?
  repairCost         Float?
  responsibility     String? // SPECIFIC_RESIDENT, ENTIRE_ROOM, OWNER
  billUrl            String?
  resolvedImageUrl   String?
  resolutionNotes    String?
  resolvedAt         DateTime?
  
  createdBy          String?
  updatedBy          String?
  isActive           Boolean           @default(true)
  deletedAt          DateTime?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  pg                 PG                @relation(fields: [pgId], references: [id])
  tenantProfile      PGTenantProfile   @relation(fields: [pgTenantId], references: [id])
  damageRecoveries   DamageRecovery[]
  depositTransactions DepositLedgerTransaction[]

  @@index([pgId])
  @@index([pgTenantId])
  @@index([status, slaDeadline])
}

model Staff {
  id             String               @id @default(uuid())
  organizationId String
  pgId           String?
  clerkUserId    String?              @unique
  name           String
  phone          String
  role           String               @default("CARETAKER")
  monthlySalary  Float                @default(0)
  joiningDate    DateTime             @default(now())
  status         String               @default("ACTIVE")
  
  createdBy      String?
  updatedBy      String?
  isActive       Boolean              @default(true)
  deletedAt      DateTime?

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  
  organization   Organization         @relation(fields: [organizationId], references: [id])
  pg             PG?                  @relation(fields: [pgId], references: [id])
  salaryPayments StaffSalaryPayment[]

  @@index([organizationId])
  @@index([pgId])
}

model EventLog {
  id        String   @id @default(uuid())
  entityId  String
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entityId])
  @@index([eventType])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityId])
  @@index([entityType])
}

model OnboardingAnalytics {
  id              String   @id @default(uuid())
  organizationId  String
  pgId            String
  actorId         String
  status          String   // SUCCESS, ABANDONED, FAILED
  isQuickAdd      Boolean  @default(false)
  durationSeconds Int?
  conflictCount   Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([pgId])
}

model DamageRecovery {
  id                    String               @id @default(uuid())
  pgId                  String
  complaintId           String?
  tenantId              String
  roomId                String
  bedId                 String?
  amount                Float
  reason                String
  resolutionNotes       String?
  attachmentUrls        String[]
  status                String               @default("PENDING") // PENDING, PARTIALLY_RECOVERED, FULLY_RECOVERED, WAIVED, DISPUTED
  recoveryMethod        String               @default("DEPOSIT") // DEPOSIT, CASH, UPI, WAIVED
  
  // Recovery Collections Fields
  amountReceived        Float                @default(0)
  paymentMode           String?
  referenceNumber       String?
  collectedDate         DateTime?
  collectionNotes       String?

  // Progress Tracking Fields
  totalAmount           Float                @default(0)
  recoveredAmount       Float                @default(0)
  outstandingAmount     Float                @default(0)

  // Dispute & Acknowledgement Fields
  acceptedAt            DateTime?
  acceptedBy            String?
  disputedAt            DateTime?
  disputeReason         String?
  waivedAt              DateTime?
  waivedReason          String?
  
  createdAt             DateTime             @default(now())
  createdBy             String?
  updatedAt             DateTime             @updatedAt
  
  pg                    PG                   @relation(fields: [pgId], references: [id])
  complaint             Complaint?           @relation(fields: [complaintId], references: [id])
  tenantProfile         PGTenantProfile      @relation(fields: [tenantId], references: [id])
  room                  Room                 @relation(fields: [roomId], references: [id])
  items                 DamageRecoveryItem[]
  
  depositTransactions   DepositLedgerTransaction[]
  recoveryTransactions  RecoveryTransaction[]
  paymentLinks          PaymentLink[]
  paymentReceipts       PaymentReceipt[]
}

model DamageRecoveryItem {
  id          String         @id @default(uuid())
  recoveryId  String
  title       String
  amount      Float
  notes       String?
  createdAt   DateTime       @default(now())
  
  recovery    DamageRecovery @relation(fields: [recoveryId], references: [id], onDelete: Cascade)
}

model DepositLedgerTransaction {
  id              String           @id @default(uuid())
  tenantProfileId String
  recoveryId      String?
  complaintId     String?
  type            String           // DEPOSIT_COLLECTED, DEPOSIT_DEDUCTION, DEPOSIT_REFUND, MANUAL_ADJUSTMENT
  amount          Float
  reason          String
  notes           String?
  createdAt       DateTime         @default(now())
  createdBy       String?

  tenantProfile   PGTenantProfile  @relation(fields: [tenantProfileId], references: [id])
  recovery        DamageRecovery?  @relation(fields: [recoveryId], references: [id], onDelete: SetNull)
  complaint       Complaint?       @relation(fields: [complaintId], references: [id], onDelete: SetNull)
}

model RecoveryTransaction {
  id              String         @id @default(uuid())
  recoveryId      String
  amount          Float
  paymentMethod   String         // DEPOSIT, UPI, CASH, WAIVED
  referenceNumber String?
  notes           String?
  createdAt       DateTime       @default(now())
  createdBy       String?

  recovery        DamageRecovery @relation(fields: [recoveryId], references: [id], onDelete: Cascade)
}

model StaffSalaryPayment {
  id          String   @id @default(uuid())
  staffId     String
  amount      Float
  paymentDate DateTime @default(now())
  salaryMonth String
  notes       String?
  createdAt   DateTime @default(now())
  
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model CleaningChecklist {
  id                  String   @id @default(uuid())
  pgId                String   @unique
  roomsCompleted      Boolean  @default(false)
  bathroomsCompleted  Boolean  @default(false)
  commonAreasCompleted Boolean  @default(false)
  kitchenCompleted    Boolean  @default(false)
  waterTankCompleted  Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  
  pg                  PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
}

model MonthlyBusinessSnapshot {
  id                String   @id @default(uuid())
  pgId              String
  month             Int
  year              Int
  occupancyPercent  Float
  revenue           Float
  expenses          Float
  profit            Float
  rentCollected     Float
  damageRecoveries  Float
  depositsCollected Float
  createdAt         DateTime @default(now())

  pg                PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)

  @@unique([pgId, month, year])
  @@index([pgId])
}

model PaymentLink {
  id                    String          @id @default(uuid())
  referenceId           String          @unique
  razorpayPaymentLinkId String?         @unique
  paymentUrl            String?
  status                String          @default("unpaid") // unpaid, paid, expired, cancelled
  amount                Float
  
  invoiceId             String?
  rentInvoice           RentInvoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  recoveryId            String?
  damageRecovery        DamageRecovery? @relation(fields: [recoveryId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([invoiceId])
  @@index([recoveryId])
}

model PaymentReceipt {
  id              String          @id @default(uuid())
  receiptNumber   String          @unique // e.g. RCP-YYYYMMDD-XXXX
  residentName    String
  amount          Float
  paymentMethod   String
  transactionId   String          @unique
  invoiceNumber   String?
  paymentDate     DateTime        @default(now())
  status          String          @default("PAID")
  
  tenantProfileId String
  tenantProfile   PGTenantProfile @relation(fields: [tenantProfileId], references: [id], onDelete: Cascade)
  
  invoiceId       String?
  rentInvoice     RentInvoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  
  recoveryId      String?
  damageRecovery  DamageRecovery? @relation(fields: [recoveryId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime        @default(now())

  @@index([tenantProfileId])
  @@index([invoiceId])
  @@index([recoveryId])
}
